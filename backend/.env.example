# ============================================================
# CivicAI Nexus — backend environment template
# Copy to backend/.env. NEVER commit the real .env.
# On Render, set these in the dashboard's Environment section.
# ============================================================

# --- Database (MongoDB Atlas or local) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=civicai

# --- Auth ---
# REQUIRED: replace with a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# With the placeholder value the server logs a startup warning — tokens are forgeable.
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend / CORS ---
# The exact origin(s) allowed to call this API. Trailing slashes are
# normalised. Local dev + the deployed frontend host both work; the dev
# server additionally always allows http://localhost:5173.
FRONTEND_URL=https://civicai-theta.vercel.app

# --- AI provider ---
# mock | groq | openai | gemini
# "mock" = fully local rule-based analysis (no key needed). If a real
# provider is misconfigured or a call fails, that single request falls back
# to mock and is honestly tagged provider:"mock" in the response.
AI_PROVIDER=groq

# Required only if AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Required only if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required only if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Email / OTP delivery ---
# mock (prints OTP + returns dev_otp in the API response — local dev only),
# smtp, or resend.
# NOTE: a Resend TEST key only delivers mail to your verified own address;
# real users get a 403 from Resend. Registration still completes because the
# API then returns dev_otp and the frontend displays it — but for production
# you need a VERIFIED Resend sender/domain (a live key) or real SMTP.
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Required only if EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=civicainexus@gmail.com
EMAIL_USE_TLS=true

# --- OTP / password reset ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- SLA tuning (hours) ---
SLA_HOURS_LOW=168
SLA_HOURS_MEDIUM=72
SLA_HOURS_HIGH=24
SLA_HOURS_CRITICAL=6

# --- Incident clustering ---
INCIDENT_CLUSTER_RADIUS_KM=1.0
INCIDENT_MIN_REPORTS=3

# --- Uploads ---
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/webm,audio/mpeg,audio/wav,audio/mp4,audio/ogg
UPLOAD_DIR=uploads

# --- Rate limiting ---
# Requests per minute per client IP against /api. 0 disables the limiter
# (used by the pytest suite; keep a real number in production).
RATE_LIMIT_PER_MINUTE=60

# --- Demo / first-run behavior ---
# true = seed demo accounts/data on startup if the DB is empty
AUTO_SEED_DEMO_DATA=true
# true = block ALL mutating requests (site-wide demo lock)
DEMO_MODE=false
# Emails whose tokens get mutations blocked (the pre-seeded demo accounts)
DEMO_ACCOUNT_EMAILS=citizen@demo.com,officer@demo.com,admin@demo.com

# --- Web Push notifications ---
# The private key was previously committed inside the source code and must
# now come from here. To keep browser push working on Render, set the same
# values you used before (or rotate the pair with
# `npx web-push generate-vapid-keys` — note: rotating invalidates existing
# browser subscriptions). If VAPID_PRIVATE_KEY is unset, browser push is
# skipped quietly; in-app notifications are unaffected.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:you@yourdomain.com
