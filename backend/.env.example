# --- Database ---
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=civicai

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173

# --- AI provider abstraction ---
# "mock" (default, fully local/offline demo mode — no API key needed),
# "openai", or "gemini"
AI_PROVIDER=mock

# Required only if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required only if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- SLA tuning (hours) ---
SLA_HOURS_LOW=168
SLA_HOURS_MEDIUM=72
SLA_HOURS_HIGH=24
SLA_HOURS_CRITICAL=6

# --- Incident clustering ---
INCIDENT_CLUSTER_RADIUS_KM=1.0
INCIDENT_MIN_REPORTS=3

# --- Uploads ---
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/webm,audio/mpeg,audio/wav,audio/mp4,audio/ogg
UPLOAD_DIR=uploads

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Demo / first-run behavior ---
AUTO_SEED_DEMO_DATA=true

EMAIL_PROVIDER=

# Required only if EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=xxx xxx xxx xxx
EMAIL_FROM=civicainexus@gmail.com
EMAIL_USE_TLS=true

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5