# API base URL used by the frontend.
# Local development (leave unset to hit the local backend):
VITE_API_BASE_URL=http://localhost:8000

# Production (Vercel build): set this in the Vercel project's Environment
# Variables. If it is left unset, the production bundle falls back to the
# deployed Render URL (see src/services/api.js) instead of localhost.
# VITE_API_BASE_URL=https://civicai-nexus.onrender.com
